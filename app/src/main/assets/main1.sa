result = pcall(function()
	return java.call(java.bindClass('java.lang.Integer'), 'parseInt', '123')
end)
assert_pcall(result, 'java.call failed')
assert(result[1] == 123, 'java.call parseInt mismatch')

result = pcall(function()
	pt = java.new('android.graphics.Point', 1, 2)
	java.setField(pt, 'x', 7)
	return java.getField(pt, 'x')
end)
assert_pcall(result, 'java.getField/setField failed')
assert(result[1] == 7, 'java.getField x mismatch')

