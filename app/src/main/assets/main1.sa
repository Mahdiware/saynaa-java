import java
import hello

LinearLayout = java.bindClass('android.widget.LinearLayout')
TextView = java.bindClass('android.widget.TextView')
Button = java.bindClass('android.widget.Button')
EditText = java.bindClass('android.widget.EditText')
Toast = java.bindClass('android.widget.Toast')
Bundle = java.bindClass('android.os.Bundle')
View = java.bindClass('android.view.View')
TextWatcher = java.bindClass('android.text.TextWatcher')
Runnable = java.bindClass('java.lang.Runnable')
CodeEditor = java.bindClass('com.saynaa.CodeEditor')

assert(LinearLayout != null, 'Failed to bind LinearLayout')
assert(TextView != null, 'Failed to bind TextView')
assert(Button != null, 'Failed to bind Button')
assert(EditText != null, 'Failed to bind EditText')
assert(Toast != null, 'Failed to bind Toast')
assert(Bundle != null, 'Failed to bind Bundle')
assert(View != null, 'Failed to bind View')
assert(TextWatcher != null, 'Failed to bind TextWatcher')
assert(Runnable != null, 'Failed to bind Runnable')

function assert_pcall(result, label)
	ok = result[0]
	if ok == null then
		ok = result[1]
	end
	if ok != true then
		err = result[1]
		if err == null then
			err = result[2]
		end
		assert(false, label + ': ' + str(err))
	end
end

function print(msg)
	Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

activity.setTitle('Saynaa Demo')


