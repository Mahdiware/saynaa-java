class moha
  function _init()
    debug("moha class initialized")
    this.value = 42
  end
  function test(a, b)
    toast("this is test $a, $b")
    return a + b
  end
end

function toast(msg)
	Toast.makeText(activity, msg, Toast.LENGTH_SHORT).show()
end

