function onCreate(arg1)
  //root = loadlayout(activity, DemoLayout)
  
  //assert(root != null, 'loadlayout returned null')
  activity.setContentView(DemoLayout)

  adapter = SaynaaAdapter(activity, AdapterItem, AdapterData)
  DemoList.setAdapter(adapter)

  DemoList.setOnItemClickListener(AdapterView.OnItemClickListener({
    onItemClick: function(parent, view, position, id)
      toast("clicked: $position")
      debug("Item clicked at position: $position, parent: $parent, view: $view, id: $id")
    end
  }))

  # params = FrameLayout.LayoutParams(width,height);

  # params.gravity = Gravity.CENTER;
  # DemoImage.setLayoutParams(params);

  nextpage.setOnClickListener(View.OnClickListener({
    onClick: function(v)
      print('next page button clicked')
      activity.newActivity('main1')
    end
  }))

  benchmark.setOnClickListener(View.OnClickListener({
    onClick: function(v)
      print('benchmark button clicked')
      activity.newActivity('main3')
    end
  }))

  errortest.setOnClickListener(View.OnClickListener({
    onClick: function(v)
      error('error test button clicked')
    end
  }))
end
